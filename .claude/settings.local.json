{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": 
  {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skill-activation-prompt.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/python-autotest.hook.ts",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun .claude/hooks/js-syntax-check.hook.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/python-autotest.hook.ts",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun .claude/hooks/js-syntax-check.hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/plan-validation.hook.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}